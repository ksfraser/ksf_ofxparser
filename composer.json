{
    "name": "ksfraser/ksf_ofxparser",
    "description": "OFX file parser with Investments support",
    "keywords": ["ofx", "open financial exchange", "finance", "parser"],
    "license": "MIT",
    "authors": [
        {
            "name": "Guillaume Bailleul",
            "email": "contact@guillaume-bailleul.fr",
            "homepage": "http://www.guillaume-bailleul.fr"
        },
        {
            "name": "James Titcumb",
            "email": "hello@jamestitcumb.com",
            "homepage": "http://www.jamestitcumb.com/"
        },
        {
            "name": "Oliver Lowe",
            "email": "mrtriangle@gmail.com"
        },
        {
            "name": "Mathias Gran",
            "email": "gitmathias@users.noreply.github.com"
        },
        {
            "name": "Kevin Fraser",
            "email": "kevin@ksfraser.com",
            "homepage": "http://ksfraser.ca/"
        }
 
    ],
    "require": {
        "php": ">=7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "~2.6",
        "nikic/php-parser": "^4.15",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "OfxParser\\": "src/Ksfraser/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OfxParserTest\\": "tests/OfxParser/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:php73-compat": "vendor/bin/phpunit tests/VersionCompatibilityTest.php",
        "analyze": "vendor/bin/phpstan analyse",
        "lint": "vendor/bin/phpcs --standard=ruleset.xml src tests",
        "lint:fix": "vendor/bin/phpcbf --standard=ruleset.xml src tests",
        "check-all": [
            "@lint",
            "@analyze",
            "@test"
        ]
    }
}
